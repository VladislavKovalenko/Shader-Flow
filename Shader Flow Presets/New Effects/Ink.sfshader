{
  "version": 1,
  "format": "sfshader",
  "name": "MyShader",
  "shaderSource": "precision mediump float;\n\n// ── Параметры: Управление эффектом ────────────────────────────────────────\n\nuniform float uAmount;        // @range 0 1       — Общая интенсивность эффекта\nuniform float uSpread;        // @range 0 2       — Сила растекания/затеков чернил\nuniform float uDetail;        // @range 0.5 5     — Масштаб детализации волокон\nuniform float uThreshold;     // @range 0.05 0.95 — Порог плотности туши\n\n// ── Параметры: Художественные техники ────────────────────────────────────\n\nuniform float uCapillary;     // @range 0 1       — Капиллярный эффект на краях\nuniform float uDryBrush;      // @range 0 1       — Эффект сухой кисти / текстурность\nuniform float uPaperGrain;    // @range 0 1       — Текстурирование бумаги\nuniform float uVignette;      // @range 0 1       — Чернильная виньетка по краям\n\n// ── Параметры: Цвет и Фон ────────────────────────────────────────────────\n\nuniform vec3  uInkColor;      // Color Picker     — Цвет чернил / туши\nuniform vec3  uPaperColor;    // Color Picker     — Цвет бумаги\nuniform bool  uPreserveColor; // Switch           — Сохранять исходный цвет (смешивание)\n\n// ── Вспомогательные функции математики и шума ─────────────────────────────\n\nfloat hash(vec2 p) {\n    p = fract(p * vec2(123.34, 456.21));\n    p += dot(p, p + 45.32);\n    return fract(p.x * p.y);\n}\n\nfloat noise(vec2 p) {\n    vec2 i = floor(p);\n    vec2 f = fract(p);\n    f = f * f * (3.0 - 2.0 * f);\n    \n    float a = hash(i);\n    float b = hash(i + vec2(1.0, 0.0));\n    float c = hash(i + vec2(0.0, 1.0));\n    float d = hash(i + vec2(1.0, 1.0));\n    \n    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);\n}\n\n// Фрактальный шум со сдвигом и поворотом слоев\nfloat fbm(vec2 p) {\n    float v = 0.0;\n    float a = 0.5;\n    mat2 rot = mat2(0.8, 0.6, -0.6, 0.8);\n    for (int i = 0; i < 5; ++i) {\n        v += a * noise(p);\n        p = rot * p * 2.02 + vec2(17.0, 92.0);\n        a *= 0.5;\n    }\n    return v;\n}\n\n// Двухуровневый Domain Warping для создания органических подтёков\nvec2 domainWarp(vec2 p, float strength) {\n    float n1 = fbm(p + vec2(0.0, iTime * 0.02));\n    float n2 = fbm(p + vec2(5.2, 1.3));\n    \n    vec2 warp1 = vec2(n1, n2);\n    vec2 warp2 = vec2(\n        fbm(p + warp1 * 2.0 + vec2(1.7, 9.2)),\n        fbm(p + warp1 * 2.0 + vec2(8.3, 2.8))\n    );\n    \n    return warp2 * strength;\n}\n\n// ── Основной шейдер ───────────────────────────────────────────────────────\n\nvoid main() {\n    vec2 uv = gl_FragCoord.xy / iResolution.xy;\n    \n    // Безопасная проверка наличия текстуры\n    if (uHasTexture == 0) {\n        gl_FragColor = vec4(uPaperColor, 1.0);\n        return;\n    }\n\n    vec2 st = uv * uDetail;\n\n    // --- МОДУЛЬ 1: Генерация маски бумаги и капилляров ---\n    float paperTexture = fbm(st * 4.0);\n    float grain = hash(gl_FragCoord.xy) * 0.08 * uPaperGrain;\n\n    // --- МОДУЛЬ 2: Растекание и Domain Warping ---\n    // Искажение UV зависящее от параметров Spread и Capillary\n    vec2 warp = domainWarp(st, uSpread * 0.15);\n    vec2 distortedUV = uv + warp;\n\n    // Чтение исходной текстуры со смещенными координатами\n    vec4 texColor = texture2D(uTexture, distortedUV);\n    float luma = dot(texColor.rgb, vec3(0.299, 0.587, 0.114));\n\n    // --- МОДУЛЬ 3: Эффект сухой кисти и краевых капилляров ---\n    // Капиллярный эффект усиливается на границах яркости\n    float edgeNoise = fbm(st * 8.0 + warp * 3.0);\n    float capillaryEffect = (edgeNoise - 0.5) * uCapillary * 0.3;\n    \n    // Коррекция порога с учетом текстуры и яркости\n    float adjustedLuma = luma + capillaryEffect;\n    \n    // Эффект сухой кисти (вычитание текстурного микро-шума из полутонов)\n    if (uDryBrush > 0.0) {\n        float brushTexture = fbm(uv * vec2(uDetail * 10.0, uDetail * 2.0));\n        adjustedLuma += (brushTexture - 0.4) * uDryBrush * (1.0 - abs(luma - 0.5) * 2.0);\n    }\n\n    // --- МОДУЛЬ 4: Формирование контуров и пигментации ---\n    // Формирование сглаженного порога (Posterization)\n    float inkMask = smoothstep(uThreshold - 0.12, uThreshold + 0.12, adjustedLuma);\n\n    // Цвет чернил: выбор между кастомным узором и цветом текстуры\n    vec3 baseInk = uPreserveColor ? mix(texColor.rgb * 0.5, uInkColor, 0.4) : uInkColor;\n    \n    // Градиент впитываемости: в центрах пятен чернила гуще, на краях светлее\n    float depth = smoothstep(0.0, uThreshold, adjustedLuma);\n    vec3 inkFinal = mix(baseInk * 0.7, baseInk, depth);\n\n    // --- МОДУЛЬ 5: Композитинг бумаги и виньетки ---\n    // Наложение цвета бумаги с микро-текстурой\n    vec3 paperFinal = uPaperColor - (paperTexture * 0.05 * uPaperGrain) - grain;\n    \n    // Итоговый скан чернил на бумаге\n    vec3 styledResult = mix(inkFinal, paperFinal, inkMask);\n\n    // Виньетирование краев холста (чернильное затемнение)\n    if (uVignette > 0.0) {\n        vec2 vUV = uv * (1.0 - uv.yx);\n        float vig = vUV.x * vUV.y * 15.0;\n        vig = pow(vig, uVignette * 0.5);\n        styledResult = mix(baseInk, styledResult, clamp(vig, 0.0, 1.0));\n    }\n\n    // Итоговое смешивание с оригиналом по параметру uAmount\n    vec3 finalColor = mix(texColor.rgb, styledResult, uAmount);\n\n    gl_FragColor = vec4(finalColor, 1.0);\n}",
  "uniforms": {
    "uAmount": {
      "type": "float",
      "value": 0.803,
      "min": 0,
      "max": 1
    },
    "uSpread": {
      "type": "float",
      "value": 0,
      "min": 0,
      "max": 2
    },
    "uDetail": {
      "type": "float",
      "value": 2.828,
      "min": 0.5,
      "max": 5
    },
    "uThreshold": {
      "type": "float",
      "value": 0.157,
      "min": 0.05,
      "max": 0.95
    },
    "uCapillary": {
      "type": "float",
      "value": 0.024,
      "min": 0,
      "max": 1
    },
    "uDryBrush": {
      "type": "float",
      "value": 0.238,
      "min": 0,
      "max": 1
    },
    "uPaperGrain": {
      "type": "float",
      "value": 1,
      "min": 0,
      "max": 1
    },
    "uVignette": {
      "type": "float",
      "value": 0.5,
      "min": 0,
      "max": 1
    },
    "uInkColor": {
      "type": "vec3color",
      "value": [
        0.07469134290126697,
        0,
        0.26146449704142016
      ],
      "min": null,
      "max": null
    },
    "uPaperColor": {
      "type": "vec3color",
      "value": [
        0,
        0.6792689891490569,
        1
      ],
      "min": null,
      "max": null
    },
    "uPreserveColor": {
      "type": "bool",
      "value": false,
      "min": null,
      "max": null
    }
  },
  "masks": [],
  "settings": {
    "resolution": "node",
    "animated": true
  }
}