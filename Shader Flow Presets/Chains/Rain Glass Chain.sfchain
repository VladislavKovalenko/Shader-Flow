          "value": 0.749,
          "min": 0,
          "max": 1
        },
        "uTrailLength": {
          "type": "float",
          "value": 0.25,
          "min": 0,
          "max": 1
        },
        "uTrailLengthRandom": {
          "type": "float",
          "value": 1,
          "min": 0,
          "max": 1
        },
        "uRainSpeed": {
          "type": "float",
          "value": 0.577,
          "min": 0,
          "max": 1
        },
        "uRainDensity": {
          "type": "float",
          "value": 1,
          "min": 0,
          "max": 1
        },
        "uDropDistortion": {
          "type": "float",
          "value": 1,
          "min": 0,
