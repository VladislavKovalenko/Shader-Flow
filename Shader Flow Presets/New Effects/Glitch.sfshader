{
  "version": 1,
  "format": "sfshader",
  "name": "MyShader",
  "shaderSource": "precision mediump float;\nuniform vec2  iResolution;\nuniform float iTime;\nuniform sampler2D uTexture;\nuniform int   uHasTexture;\nuniform float uAmount; // Общая сила глитча (от 0.0 до 1.0)\n\n// 1. Модуль генерации псевдослучайных чисел (Шум)\nfloat hash(vec2 p) {\n    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);\n}\n\nvoid main() {\n    vec2 uv = gl_FragCoord.xy / iResolution.xy;\n    \n    // 2. Модуль расчета искажения (Глитча)\n    // Разбиваем экран на горизонтальные полосы, добавляя iTime для динамики\n    float blockNoise = hash(vec2(floor(uv.y * 20.0), floor(iTime * 15.0)));\n    float lineNoise  = hash(vec2(floor(uv.y * 100.0), floor(iTime * 30.0)));\n    \n    // Сдвиг происходит только если случайное число превышает порог активности глитча\n    float shiftX = 0.0;\n    if (blockNoise < uAmount * 0.4) {\n        shiftX = (hash(vec2(floor(iTime * 10.0), blockNoise)) - 0.5) * 0.1;\n    }\n    // Добавляем мелкие и быстрые \"игольчатые\" полосы\n    if (lineNoise < uAmount * 0.2) {\n        shiftX += (hash(vec2(floor(iTime * 40.0), lineNoise)) - 0.5) * 0.03;\n    }\n\n    // Применяем вычисленный сдвиг к текстурным координатам\n    vec2 distortedUV = vec2(fract(uv.x + shiftX), uv.y);\n\n    // 3. Модуль вывода изображения\n    if (uHasTexture == 1) {\n        // Делаем небольшой разнос каналов (хроматическую аберрацию) только в момент сдвига\n        float r = texture2D(uTexture, distortedUV + vec2(shiftX * 0.5, 0.0)).r;\n        float g = texture2D(uTexture, distortedUV).g;\n        float b = texture2D(uTexture, distortedUV - vec2(shiftX * 0.5, 0.0)).b;\n        float al = texture2D(uTexture, distortedUV).a;\n        \n        gl_FragColor = vec4(r, g, b, al);\n    } else {\n        // Визуализация глитча без текстуры (процедурная сетка с шумом)\n        float stripes = step(0.5, sin(distortedUV.x * 20.0) * cos(distortedUV.y * 20.0));\n        vec3 color = vec3(stripes, distortedUV.y, 0.5 + sin(iTime) * 0.5);\n        gl_FragColor = vec4(color, 1.0);\n    }\n}",
  "uniforms": {
    "uAmount": {
      "type": "float",
      "value": 10,
      "min": 1,
      "max": 100
    }
  },
  "masks": [],
  "settings": {
    "resolution": "node",
    "animated": true
  }
}